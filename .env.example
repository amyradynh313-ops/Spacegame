# آدرس سایت (برای سئو، sitemap و لینک‌های canonical). حتماً با دامنه‌ی واقعی عوض کن
SITE_URL=https://example.com

PORT=3000
HOST=0.0.0.0

# آیدی تلگرام پشتیبانی (بدون @)
TELEGRAM_USERNAME=Amir56743

# اطلاعات ورود ادمین. فقط وقتی دیتابیس خالی است ساخته می‌شود
